{
  "rules": {
    "owners": {
      "$table": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "tables": {
      "$table": {
        ".read": true,
        ".write": "auth != null && root.child('owners').child($table).val() === auth.uid",
        ".validate": "newData.hasChildren(['state']) && newData.child('state').isString() && newData.child('state').val().length < 200000"
      }
    }
  }
}
